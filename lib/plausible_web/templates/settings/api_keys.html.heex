<.settings_tiles>
  <.tile
    docs="stats-api"
    current_user={@current_user}
    current_team={@current_team}
    feature_mod={Plausible.Billing.Feature.StatsAPI}
  >
    <:title>
      <a id="api-keys">Chaves de API</a>
    </:title>
    <:subtitle :if={not Enum.empty?(@api_keys)}>
      Crie e gerencie o acesso.
    </:subtitle>

    <%= if Enum.empty?(@api_keys) do %>
      <div class="flex flex-col items-center justify-center pt-5 pb-6 max-w-md mx-auto">
        <h3 class="text-center text-base font-medium text-gray-900 dark:text-gray-100 leading-7">
          Crie sua primeira chave de API
        </h3>
        <p class="text-center text-sm mt-1 text-gray-500 dark:text-gray-400 leading-5 text-pretty">
          Acesse suas estatísticas pela API do Plausible.
          <.styled_link href="https://plausible.io/docs/stats-api">Saiba mais</.styled_link>
        </p>
        <.button_link href={Routes.settings_path(@conn, :new_api_key)}>
          Nova chave de API
        </.button_link>
      </div>
    <% else %>
      <.filter_bar filtering_enabled?={false}>
        <.button_link mt?={false} href={Routes.settings_path(@conn, :new_api_key)}>
          Nova chave de API
        </.button_link>
      </.filter_bar>

      <.table rows={@api_keys}>
        <:thead>
          <.th>
            Nome
          </.th>
          <.th hide_on_mobile>
            Chave
          </.th>
          <.th :if={ee?()} hide_on_mobile>
            Tipo
          </.th>
          <.th invisible>
            Ações
          </.th>
        </:thead>

        <:tbody :let={api_key}>
          <.td truncate max_width="max-w-40">
            {api_key.name}
          </.td>
          <.td hide_on_mobile>
            {api_key.key_prefix}
            {String.duplicate("*", 32 - 6)}
          </.td>
          <.td :if={ee?()}>
            <span :if={api_key.type == "stats_api"}>API de estatísticas</span>
            <span :if={api_key.type == "sites_api"}>API de sites</span>
          </.td>
          <.td actions>
            <.delete_button
              method="delete"
              href={Routes.settings_path(@conn, :delete_api_key, api_key.id)}
              data-confirm="Tem certeza que deseja revogar esta chave? Esta ação não pode ser desfeita."
            />
          </.td>
        </:tbody>
      </.table>
    <% end %>
  </.tile>
</.settings_tiles>
