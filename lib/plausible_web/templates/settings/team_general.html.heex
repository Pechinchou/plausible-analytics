<.settings_tiles>
  <.tile docs="users-roles">
    <:title>
      <a id="update-name#changing-the-name-of-a-team">Nome da equipe</a>
    </:title>
    <:subtitle>
      Altere o nome da sua equipe.
    </:subtitle>
    <.form
      :let={f}
      action={Routes.settings_path(@conn, :update_team_name)}
      for={@team_name_changeset}
      method="post"
    >
      <.input
        readonly={@current_team_role not in [:owner, :admin]}
        type="text"
        field={f[:name]}
        label="Nome"
        width="w-1/2"
        mt?={false}
      />

      <.button type="submit" disabled={@current_team_role not in [:owner, :admin]}>
        Alterar nome
      </.button>
    </.form>
  </.tile>
  <.tile
    docs="users-roles#managing-team-member-roles"
    current_user={@current_user}
    current_team={@current_team}
    feature_mod={Plausible.Billing.Feature.Teams}
  >
    <:title>
      <a id="team-members">Membros da equipe</a>
    </:title>
    <:subtitle>
      Adicione ou remova membros da equipe e ajuste suas funções.
    </:subtitle>
    {live_render(@conn, PlausibleWeb.Live.TeamManagement,
      id: "team-setup",
      session: %{"mode" => "team-management"}
    )}
  </.tile>
  <.tile :if={@current_team_role == :owner} docs="2fa#require-all-team-members-to-enable-2fa">
    <:title>
      <a id="force-2fa">Forçar Autenticação de Dois Fatores (2FA)</a>
    </:title>
    <:subtitle>
      Aumente a segurança da conta exigindo que todos os membros da equipe ativem o 2FA.
    </:subtitle>

    <div
      :if={@force_2fa_enabled? and @current_team_role == :owner}
      id="disable-force-2fa"
      x-data="{disableTeamForce2FAOpen: false}"
    >
      <.form
        action={Routes.settings_path(@conn, :disable_team_force_2fa)}
        for={@conn.params}
        method="post"
      >
        <.button
          theme="danger"
          x-on:click="disableTeamForce2FAOpen = true; $refs.disableTeamForce2FAPassword.value = ''"
          mt?={false}
        >
          Parar de forçar 2FA
        </.button>

        <PlausibleWeb.Components.TwoFactor.modal
          id="disable-force-2fa-modal"
          state_param="disableTeamForce2FAOpen"
          form_data={@conn.params}
          form_target={Routes.settings_path(@conn, :disable_team_force_2fa)}
          title="Parar de exigir 2FA?"
        >
          <:icon>
            <Heroicons.shield_exclamation class="h-6 w-6" />
          </:icon>
          <:buttons>
            <.button type="submit" class="w-full sm:w-auto">
              Parar de exigir 2FA
            </.button>
          </:buttons>

          <div class="text-sm mt-2">
            Isso removerá o requisito de 2FA para todos os membros da equipe.
          </div>

          <div class="text-sm mt-2">
            Digite sua senha para parar de exigir o 2FA.
          </div>

          <div class="mt-3">
            <.input
              type="password"
              id="disable_team_force_2fa_password"
              name="password"
              value=""
              placeholder="Digite a senha"
              x-ref="disableTeamForce2FAPassword"
            />
          </div>
        </PlausibleWeb.Components.TwoFactor.modal>
      </.form>
    </div>

    <div :if={not @force_2fa_enabled? and @current_team_role == :owner} id="enable-force-2fa">
      <.form
        action={Routes.settings_path(@conn, :enable_team_force_2fa)}
        for={@conn.params}
        method="post"
      >
        <.button
          data-confirm="Todos os membros da equipe, incluindo você, precisarão configurar o 2FA. Tem certeza de que deseja exigi-lo?"
          type="submit"
          mt?={false}
        >
          Exigir 2FA
        </.button>
      </.form>
    </div>
  </.tile>
  <.tile docs="users-roles#leaving-team">
    <:title>Sair da equipe</:title>
    <:subtitle>Remova-se desta equipe como membro.</:subtitle>
    <.button_link
      data-confirm="Tem certeza de que deseja sair desta equipe?"
      href={Routes.settings_path(@conn, :leave_team)}
      method="post"
      theme="danger"
      mt?={false}
    >
      Sair da equipe
    </.button_link>
  </.tile>
</.settings_tiles>
