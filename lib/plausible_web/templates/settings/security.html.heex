<.settings_tiles>
  <.tile :if={Plausible.Users.type(@current_user) == :standard} docs="change-email">
    <:title>
      <a id="update-email">Endereço de e-mail</a>
    </:title>
    <:subtitle>
      Altere o endereço associado à sua conta.
    </:subtitle>
    <.form
      :let={f}
      action={Routes.settings_path(@conn, :update_email)}
      for={@email_changeset}
      method="post"
    >
      <.input
        type="text"
        name="user[current_email]"
        value={f.data.email}
        label="E-mail atual"
        width="w-1/2"
        mt?={false}
        disabled
      />

      <.input type="email" field={f[:email]} label="Novo e-mail" width="w-1/2" />

      <.input type="password" field={f[:password]} label="Confirmar com senha" width="w-1/2" />

      <.button type="submit">
        Alterar e-mail
      </.button>
    </.form>
  </.tile>

  <.tile :if={Plausible.Users.type(@current_user) == :sso}>
    <:title>
      <a id="view-email">Endereço de e-mail</a>
    </:title>
    <:subtitle>
      Endereço associado à sua conta.
    </:subtitle>
    <.form :let={f} for={@email_changeset}>
      <.input
        type="text"
        name="user[current_email]"
        value={f.data.email}
        label="E-mail atual"
        width="w-1/2"
        mt?={false}
        disabled
      />
    </.form>
  </.tile>

  <.tile :if={Plausible.Users.type(@current_user) == :standard} docs="reset-password">
    <:title>
      <a id="update-password">Senha</a>
    </:title>
    <:subtitle>
      Altere sua senha.
    </:subtitle>
    <.form
      :let={f}
      action={Routes.settings_path(@conn, :update_password)}
      for={@password_changeset}
      method="post"
    >
      <.input
        type="password"
        max_one_error
        field={f[:old_password]}
        label="Senha atual"
        width="w-1/2"
        mt?={false}
      />

      <.input
        type="password"
        max_one_error
        field={f[:password]}
        label="Nova senha"
        width="w-1/2"
      />

      <.input
        type="password"
        max_one_error
        autocomplete="new-password"
        field={f[:password_confirmation]}
        label="Confirmar nova senha"
        width="w-1/2"
      />

      <div :if={@totp_enabled?} class="mt-6">
        <.label for={f[:two_factor_code].id} class="mb-2">
          Verificar com código 2FA
        </.label>
        <PlausibleWeb.Components.TwoFactor.verify_2fa_input
          form={f}
          show_button?={false}
          field={:two_factor_code}
          class="w-1/2"
        />
      </div>

      <.button type="submit">
        Alterar senha
      </.button>
    </.form>
  </.tile>

  <.tile docs="2fa">
    <:title>
      <a id="update-2fa">Autenticação de dois fatores (2FA)</a>
    </:title>
    <:subtitle>
      Proteja sua conta adicionando uma etapa extra de segurança ao fazer login.
    </:subtitle>

    <div x-data="{disable2FAOpen: false, regenerate2FAOpen: false}">
      <div :if={@totp_enabled?}>
        <.button
          disabled={Plausible.Users.type(@current_user) == :sso}
          x-on:click="disable2FAOpen = true; $refs.disable2FAPassword.value = ''"
          theme="danger"
          mt?={false}
        >
          Desativar 2FA
        </.button>

        <p class="mt-2 text-gray-600 text-sm dark:text-gray-400">
          Perdeu seus códigos de recuperação?
          <a
            href="#update-2fa"
            x-on:click="regenerate2FAOpen = true; $refs.regenerate2FAPassword.value = ''"
            class="underline text-indigo-600"
          >
            Gerar novos
          </a>
        </p>
      </div>

      <div :if={not @totp_enabled?}>
        <.form
          action={Routes.auth_path(@conn, :initiate_2fa_setup)}
          for={@conn.params}
          method="post"
        >
          <.button type="submit" mt?={false}>
            Ativar 2FA
          </.button>
        </.form>
      </div>

      <PlausibleWeb.Components.TwoFactor.modal
        id="disable-2fa-modal"
        state_param="disable2FAOpen"
        form_data={@conn.params}
        form_target={Routes.auth_path(@conn, :disable_2fa)}
        title="Desativar a autenticação de dois fatores?"
      >
        <:icon>
          <Heroicons.shield_exclamation class="h-6 w-6" />
        </:icon>
        <:buttons>
          <.button type="submit" class="w-full sm:w-auto">
            Desativar 2FA
          </.button>
        </:buttons>

        <div class="text-sm mt-2">
          Uma vez desativado, os códigos de verificação do aplicativo autenticador e os códigos de recuperação atuais tornar-se-ão inválidos. O 2FA precisará ser configurado do início.
        </div>

        <div class="text-sm mt-2">
          Digite sua senha para desativar o 2FA.
        </div>

        <div class="mt-3">
          <.input
            type="password"
            id="disable_2fa_password"
            name="password"
            value=""
            placeholder="Digite a senha"
            x-ref="disable2FAPassword"
          />
        </div>
      </PlausibleWeb.Components.TwoFactor.modal>

      <PlausibleWeb.Components.TwoFactor.modal
        id="regenerate-2fa-modal"
        state_param="regenerate2FAOpen"
        form_data={@conn.params}
        form_target={Routes.auth_path(@conn, :generate_2fa_recovery_codes)}
        onsubmit="document.getElementById('generate-2fa-recovery-button').disabled = true"
        title="Gerar novos códigos de recuperação?"
      >
        <:icon>
          <Heroicons.key class="h-6 w-6" />
        </:icon>

        <:buttons>
          <.button
            id="generate-2fa-recovery-button"
            type="submit"
            class="w-full sm:w-auto [&>span.label-enabled]:block [&>span.label-disabled]:hidden [&[disabled]>span.label-enabled]:hidden [&[disabled]>span.label-disabled]:block"
          >
            <span class="label-enabled pointer-events-none">
              Gerar novos códigos
            </span>

            <span class="label-disabled">
              <.spinner class="inline-block h-5 w-5 mr-2 text-white dark:text-gray-400" />
              Gerando códigos
            </span>
          </.button>
        </:buttons>

        <div class="text-sm mt-2">
          Se você gerar novos códigos, os antigos tornar-se-ão inválidos.
        </div>

        <div class="text-sm mt-2">
          Digite sua senha para continuar.
        </div>

        <div class="mt-3 w-full">
          <.input
            type="password"
            id="regenerate_2fa_password"
            name="password"
            value=""
            placeholder="Digite a senha"
            x-ref="regenerate2FAPassword"
          />
        </div>
      </PlausibleWeb.Components.TwoFactor.modal>
    </div>
  </.tile>

  <.tile docs="login-management">
    <:title>
      <a id="user-sessions">Gerenciamento de sessões</a>
    </:title>
    <:subtitle>
      Sair de outros dispositivos. Sessões inativas expiram automaticamente após 14 dias.
    </:subtitle>

    <.table rows={@user_sessions}>
      <:thead>
        <.th>Dispositivo</.th>
        <.th hide_on_mobile>Último acesso</.th>
        <.th invisible>Ações</.th>
      </:thead>
      <:tbody :let={session}>
        <.td truncate max_width="max-w-40">{session.device}</.td>
        <.td hide_on_mobile>{Plausible.Auth.UserSessions.last_used_humanize(session)}</.td>
        <.td :if={@current_user_session.id == session.id} actions>Sessão atual</.td>
        <.td :if={@current_user_session.id != session.id} actions>
          <.delete_button
            href={Routes.settings_path(@conn, :delete_session, session.id)}
            method="delete"
            data-confirm="Tem certeza que deseja encerrar esta sessão?"
          />
        </.td>
      </:tbody>
    </.table>
  </.tile>
</.settings_tiles>
