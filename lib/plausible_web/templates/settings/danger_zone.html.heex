<.notice title="Zona de perigo" theme={:red}>
  As ações abaixo podem resultar em perda irreversível de dados. Tenha cuidado.
</.notice>

<.settings_tiles>
  <.tile docs="delete-account">
    <:title>Excluir conta</:title>
    <:subtitle>Exclui permanentemente seus sites e todas as estatísticas coletadas.</:subtitle>

    <%= cond do %>
      <% length(@solely_owned_teams) > 0 -> %>
        <.notice theme={:gray} title="Você ainda não pode excluir sua conta">
          Você é o único proprietário de uma ou mais equipes. Para excluir sua conta, adicione outro proprietário ou exclua cada uma das seguintes equipes:
          <ul class="w-full py-4">
            <li :for={team <- @solely_owned_teams} class="pt-1">
              <.styled_link href={
                Routes.settings_path(@conn, :team_general, __team: team.identifier)
              }>
                {Plausible.Teams.name(team)}
              </.styled_link>
            </li>
          </ul>
        </.notice>
      <% Plausible.Billing.Subscription.Status.active?(@my_team && @my_team.subscription) -> %>
        <.notice theme={:gray} title="Você ainda não pode excluir sua conta">
          Você possui uma assinatura ativa. Para excluir sua conta, cancele sua assinatura primeiro.
        </.notice>
      <% true -> %>
        <.button_link
          data-confirm="Excluir sua conta também excluirá todos os sites e dados que você possui. Esta ação não pode ser desfeita. Tem certeza?"
          href="/me"
          method="delete"
          theme="danger"
          mt?={false}
        >
          Excluir minha conta
        </.button_link>
    <% end %>
  </.tile>
</.settings_tiles>
