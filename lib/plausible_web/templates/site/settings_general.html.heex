<.settings_tiles>
  <.tile :if={Plausible.Sites.regular?(@site)} docs="change-domain-name">
    <:title>
      Domínio do site
    </:title>
    <:subtitle>
      Movendo seu site para outro domínio? Podemos ajudar!
    </:subtitle>
    <.input name="domain" label="Domínio" value={@site.domain} disabled width="w-1/2" mt?={false} />

    <.button_link href={Routes.site_path(@conn, :change_domain, @site.domain)}>
      Alterar domínio
    </.button_link>
  </.tile>

  <.tile docs="general">
    <:title>Fuso horário do site</:title>
    <:subtitle>Atualize o fuso horário dos seus relatórios.</:subtitle>
    <.form :let={f} for={@changeset} action={"/#{URI.encode_www_form(@site.domain)}/settings"}>
      <.input
        field={f[:timezone]}
        label="Fuso horário dos relatórios"
        type="select"
        options={Plausible.Timezones.options()}
        width="w-1/2"
        mt?={false}
      />
      <.button type="submit">
        Salvar fuso horário
      </.button>
    </.form>
  </.tile>
  <.tile :if={Plausible.Sites.regular?(@site)} docs="plausible-script">
    <:title>Instalação do site</:title>
    <:subtitle>
      Controle quais dados são coletados e verifique sua instalação.
    </:subtitle>
    <.button_link
      href={
        Routes.site_path(@conn, :installation, @site.domain, flow: PlausibleWeb.Flows.review())
      }
      mt?={false}
    >
      Revisar instalação
    </.button_link>
  </.tile>
</.settings_tiles>
