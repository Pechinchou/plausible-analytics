<.notice title="Zona de perigo" theme={:red}>
  As ações abaixo podem resultar em perda irreversível de dados. Tenha cuidado.
</.notice>

<.settings_tiles>
  {live_render(@conn, PlausibleWeb.Live.SiteTransferSettings,
    id: "site-transfer-settings",
    session: %{"domain" => @site.domain}
  )}

  <.tile docs="reset-site-data">
    <:title>Redefinir estatísticas</:title>
    <:subtitle>Redefine todas as estatísticas, mas mantém a configuração do site intacta.</:subtitle>
    <.button_link
      href={Routes.site_path(@conn, :reset_stats, @site.domain)}
      method="delete"
      data-confirm="A redefinição das estatísticas não pode ser desfeita. Tem certeza?"
      theme="danger"
      mt?={false}
    >
      Redefinir estatísticas de {@site.domain}
    </.button_link>
  </.tile>

  <.tile docs="delete-site-data">
    <:title>Excluir site</:title>
    <:subtitle>Exclui permanentemente todas as estatísticas e configurações do site.</:subtitle>
    <.button_link
      href={Routes.site_path(@conn, :delete_site, @site.domain)}
      theme="danger"
      method="delete"
      data-confirm="A exclusão dos dados do site não pode ser desfeita. Tem certeza?"
      mt?={false}
    >
      Excluir {@site.domain}
    </.button_link>
  </.tile>
</.settings_tiles>
