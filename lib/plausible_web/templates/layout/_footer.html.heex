<div class="mt-24 bg-gray-800 dark:bg-gray-900">
  <div class="container px-4 py-12 sm:px-6 lg:py-16 lg:px-8">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="my-8 xl:my-0">
        <h4 class="font-semibold tracking-wider text-gray-300 leading-5">
          <img
            src={
              PlausibleWeb.Router.Helpers.static_path(
                @conn,
                logo_path("logo_dark.svg")
              )
            }
            class="inline-block w-32 mr-1"
            alt="Plausible logo"
            loading="lazy"
          />
        </h4>
        <p class="mt-4 text-base text-gray-400 leading-6">
          <%= if ee?() do %>
            <a href="/eu-hosted-web-analytics" class="text-gray-300 hover:text-white">
              Feito e hospedado na UE <span class="text-lg">🇪🇺</span>
            </a>
            <br /> Financiado inteiramente pelos nossos assinantes.
          <% end %>

          <%= if ce?() do %>
            Este painel está sendo executado em infraestrutura autogerenciada, não testada pela Plausible Analytics. Não podemos garantir seu desempenho ou confiabilidade. Para hospedagem gerenciada oficial, acesse
            <.styled_link href="https://plausible.io">
              plausible.io
            </.styled_link>
          <% end %>
        </p>
      </div>
      <div class="grid grid-cols-2 gap-8 xl:col-span-2">
        <div class="md:grid md:grid-cols-2 md:gap-8 print:hidden">
          <div>
            <h4 class="text-sm font-semibold tracking-wider text-gray-400 uppercase leading-5">
              Primeiros passos
            </h4>
            <ul class="mt-4">
              <li>
                <a
                  href="https://plausible.io/docs/integration-guides"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Guias de instalação
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/wordpress-analytics-plugin"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Plugin WordPress
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/gtm-template"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Configuração GTM
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/troubleshoot-integration"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Verificar instalação
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/google-analytics-import"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Migração GA4
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/script-extensions"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Medição avançada
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/users-roles"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Criar uma equipe
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/2fa"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Ativar 2FA
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/excluding"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Excluir tráfego
                </a>
              </li>
            </ul>
          </div>
          <div class="mt-32 md:mt-0">
            <h4 class="text-sm font-semibold tracking-wider text-gray-400 uppercase leading-5">
              Explorar
            </h4>
            <ul class="mt-4">
              <li>
                <a
                  href="https://plausible.io/docs/guided-tour"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Tour pelo painel
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/filters-segments"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Segmentar audiência
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/top-referrers"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Rastrear campanhas
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/goal-conversions"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Conversões de eventos
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/funnel-analysis"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Análise de funis
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/ecommerce-revenue-tracking"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Atribuição de receita
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/custom-props/introduction"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Propriedades personalizadas
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/google-search-console-integration"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Integração Search Console
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs/proxy/introduction"
                  class="text-base text-gray-300 leading-6 hover:text-white"
                >
                  Contornar bloqueadores
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8 print:hidden">
          <div>
            <h4 class="text-sm leading-5 font-semibold tracking-wider text-gray-400 uppercase">
              Recursos
            </h4>
            <ul class="mt-4">
              <li>
                <a
                  href="https://plausible.io/changelog"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Novidades
                </a>
              </li>
              <li class="mt-4">
                <a
                  rel="noreferrer"
                  target="_blank"
                  href="https://plausible.io/status"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Status
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/blog"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Blog
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/tools"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Ferramentas
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/docs"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Documentação
                </a>
              </li>
              <li class="mt-4">
                <a
                  rel="noreferrer"
                  target="_blank"
                  href="https://github.com/plausible/analytics"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  GitHub
                </a>
              </li>
              <li class="mt-4">
                <a
                  rel="noreferrer"
                  target="_blank"
                  href="https://twitter.com/plausiblehq"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Twitter
                </a>
              </li>
              <li class="mt-4">
                <a
                  rel="noreferrer"
                  target="_blank"
                  href="https://bsky.app/profile/plausible.io"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Bluesky
                </a>
              </li>
              <li class="mt-4">
                <a
                  rel="noreferrer me"
                  target="_blank"
                  href="https://fosstodon.org/@plausible"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Mastodon
                </a>
              </li>
              <li class="mt-4">
                <a
                  rel="noreferrer"
                  target="_blank"
                  href="https://www.linkedin.com/company/plausible-analytics/"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  LinkedIn
                </a>
              </li>
            </ul>
          </div>
          <div class="mt-12 md:mt-0">
            <h4 class="text-sm leading-5 font-semibold tracking-wider text-gray-400 uppercase">
              Empresa
            </h4>
            <ul class="mt-4">
              <li class="mt-4">
                <a
                  href="https://plausible.io/about"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Sobre
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/#pricing"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Preços
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/contact"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Contato
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/privacy"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Política de privacidade
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/data-policy"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Política de dados
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/terms"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Termos
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/dpa"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  DPA
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/security"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Segurança
                </a>
              </li>
              <li class="mt-4">
                <a
                  href="https://plausible.io/imprint"
                  class="text-base leading-6 text-gray-300 hover:text-white"
                >
                  Impressum
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
